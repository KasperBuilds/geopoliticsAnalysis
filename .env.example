# ── SENTINEL Configuration ──────────────────────────────────
# Copy this file to .env and fill in your credentials.

# OpenRouter API Key (LLM reasoning via openrouter.ai)
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key-here

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Telegram Chat ID (get from @userinfobot)
TELEGRAM_CHAT_ID=your-chat-id-here

# ── Optional Overrides ──────────────────────────────────────

# OpenRouter model (default: openai/gpt-4o)
# OPENROUTER_MODEL=openai/gpt-4o

# Schedule times in SGT (default: 06:00, 12:00, 18:00)
# SCHEDULE_HOURS=6,12,18

# Timezone (default: Asia/Singapore)
# TIMEZONE=Asia/Singapore

# Log level (default: INFO)
# LOG_LEVEL=INFO
