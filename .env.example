# ── SENTINEL Configuration ──────────────────────────────────
# Copy this file to .env and fill in your credentials.

# OpenRouter API Key (LLM reasoning via openrouter.ai)
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key-here

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Telegram Chat ID (get from @userinfobot)
TELEGRAM_CHAT_ID=your-chat-id-here

# ── Instagram / Meta Graph API ──────────────────────────────
# Instagram Business (or professional) account IG user ID
INSTAGRAM_ACCOUNT_ID=

# Long-lived User access token with instagram_basic + instagram_content_publish
META_ACCESS_TOKEN=

# Graph API version (default: v21.0)
# META_GRAPH_API_VERSION=v21.0

# Publishing is OFF by default. Set both to publish for real:
#   INSTAGRAM_PUBLISH_ENABLED=true
#   INSTAGRAM_DRY_RUN=false
INSTAGRAM_PUBLISH_ENABLED=false
INSTAGRAM_DRY_RUN=true

# Send Story preview / publish confirmation via Telegram (default: true)
# TELEGRAM_STORY_PREVIEW=true

# ── Public object storage (required for real Instagram publish) ──
# local = save locally only (dry-run / fixtures)
# s3    = AWS S3 or S3-compatible (Cloudflare R2, MinIO)
STORAGE_BACKEND=local

# S3_BUCKET=your-public-bucket
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=https://xxxx.r2.cloudflarestorage.com
# S3_PUBLIC_BASE_URL=https://cdn.example.com

# ── Optional Overrides ──────────────────────────────────────

# OpenRouter model (default: openai/gpt-4o)
# OPENROUTER_MODEL=openai/gpt-4o

# OpenRouter base URL (default: https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Schedule times in SGT (default: 06:00, 12:00, 18:00)
# SCHEDULE_HOURS=6,12,18

# Timezone (default: Asia/Singapore)
# TIMEZONE=Asia/Singapore

# Log level (default: INFO)
# LOG_LEVEL=INFO

# Archive directory for Story JSON + images (default: ./output)
# OUTPUT_DIR=output
